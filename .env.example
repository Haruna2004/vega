# --- Meta Model API -------------------------------------------------------
# Key from https://dev.meta.ai (MODEL_API_KEY is also accepted).
META_MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
MEND_SPARK_MODEL=muse-spark-1.3
# Cheaper model for per-frame triage (e.g. muse-spark-1.3-contributor for non-sensitive tests)
MEND_SPARK_FAST_MODEL=muse-spark-1.3
MEND_SAM_MODEL=sam-3.1
MEND_ASR_MODEL=muse-voice-transcribe-1.0

# --- Behaviour -------------------------------------------------------------
# 1 = never call the API; every response must come from data/cache (demo mode)
MEND_OFFLINE=0
MEND_DATA_DIR=./data
# Proxy video fed to SAM and the UI: fps and max height
MEND_PROXY_FPS=15
MEND_PROXY_HEIGHT=720
# SAM video chunk length (s) and overlap (frames) used to stitch tracks
MEND_CHUNK_SECONDS=20
MEND_CHUNK_OVERLAP_FRAMES=4
# Triage sampling
MEND_TRIAGE_EVERY_S=2
MEND_SAMPLE_FPS=2
# Credit guard: max uncached SAM calls per process
MEND_MAX_SAM_CALLS=120
MEND_SAM_MIN_TRACK_FRAMES=3
MEND_SAM_MIN_CONFIDENCE=0.35

# --- Geo -------------------------------------------------------------------
# nominatim | off
MEND_GEOCODER=nominatim
MEND_NOMINATIM_URL=https://nominatim.openstreetmap.org
MEND_OVERPASS_URL=https://overpass-api.de/api/interpreter
MEND_USER_AGENT=MEND-road-auditor/0.1 (hackathon demo)

# --- PDF -------------------------------------------------------------------
# Path to Chrome/Chromium for PDF export (auto-detected if empty)
MEND_CHROME=
