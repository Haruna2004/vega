{% set s = site %}{% set sb = site_boq %}<!doctype html>
<html><head><meta charset="utf-8"><title>Work order {{ s.id }}, {{ run.name }}</title>
<style>{% include "_doc.css" %}</style></head>
<body><div class="doc">
<header class="top">
  {% include "_brand.j2" %}
  <div class="meta">Work order {{ s.id }}<br>{{ authority }}<br>Survey: {{ run.name }}<br>Issued {{ generated }}</div>
</header>
<h1>Work order {{ s.id }}{% if s.street %}: {{ s.street }}{% endif %}</h1>
<p class="sub">Priority rank {{ s.rank }} of {{ sites|length }}</p>

<dl class="kv">
  <dt>Location</dt><dd>{{ "%.6f"|format(s.lat) }}, {{ "%.6f"|format(s.lon) }} (<a href="https://www.openstreetmap.org/?mlat={{ s.lat }}&mlon={{ s.lon }}#map=19/{{ s.lat }}/{{ s.lon }}">map</a>){% if s.area %}, {{ s.area }}{% endif %}</dd>
  <dt>Road class</dt><dd>{{ s.road_class or "unknown" }}</dd>
  <dt>Priority score</dt><dd>{{ s.priority_score }} / 100</dd>
  <dt>Nearby</dt><dd>{% for p in s.pois[:5] if p.distance_m <= 150 %}{{ p.name }} ({{ p.kind|replace("_"," ") }}, {{ p.distance_m }} m){% if not loop.last %}; {% endif %}{% else %}None recorded within 150 m{% endfor %}</dd>
</dl>

{% if s.rationale %}<h2>Reason for priority</h2><p>{{ s.rationale }}</p>{% endif %}
{% if s.voice %}<h2>Field note</h2><p>“{{ s.voice.transcript }}”</p>{% endif %}

<h2>Defects</h2>
<table><tr><th>ID</th><th>Type</th><th class="num">Severity</th><th class="num">Size</th><th>Position</th></tr>
{% for did in s.defect_ids %}{% set d = defects[did] %}
<tr><td>{{ d.id }}</td><td>{{ d.label }}</td><td class="num">{{ d.severity }} / 5</td>
<td class="num">{% if d.area_m2 is not none and d.quantity_key != "length_m" %}{{ "%.2f"|format(d.area_m2) }} m²<br><span class="small muted">{{ "%.2f"|format(d.conf_low) }} to {{ "%.2f"|format(d.conf_high) }}</span>{% elif d.length_m %}{{ "%.1f"|format(d.length_m) }} m{% else %}Size {{ d.size_bucket }}{% endif %}</td>
<td>{{ d.position|replace("_"," ") }}</td></tr>
{% endfor %}</table>

<h2>Bill of quantities</h2>
<table><tr><th>Item</th><th>Defect</th><th class="num">Qty</th><th>Unit</th><th class="num">Rate</th><th class="num">Amount</th></tr>
{% for ln in sb.lines %}<tr><td>{{ ln.description }}<br><span class="small muted">{{ ln.basis }}</span></td><td>{{ ln.defect_id }}</td><td class="num">{{ "%.2f"|format(ln.qty) }}</td><td>{{ ln.unit|replace("m2","m²") }}</td><td class="num">{{ ln.rate|money(sym) }}</td><td class="num">{{ ln.amount|money(sym) }}</td></tr>{% endfor %}
<tr><td colspan="5">Mobilisation and traffic management</td><td class="num">{{ sb.mobilisation|money(sym) }}</td></tr>
<tr class="total"><td colspan="5">Total ({{ boq.currency }})</td><td class="num">{{ sb.total|money(sym) }}</td></tr></table>
<p class="small muted">Unit rates are placeholders. Replace them with the authority's schedule of rates.</p>

<h2>Evidence</h2>
<div class="evidence">
{% for did in s.defect_ids %}{% set d = defects[did] %}{% if d.evidence_frame %}
<figure><img src="../{{ d.evidence_frame }}"><figcaption>{{ d.id }}, {{ d.label }}, frame {{ d.best_frame }} ({{ d.t }} s)</figcaption></figure>
<figure><img src="../{{ d.evidence }}"><figcaption>{{ d.id }}, close-up</figcaption></figure>
{% endif %}{% endfor %}
</div>

{% include "_signatures.j2" %}
</div></body></html>
