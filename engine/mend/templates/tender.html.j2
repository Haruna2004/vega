<!doctype html>
<html><head><meta charset="utf-8"><title>Request for Quotation, {{ run.name }}</title>
<style>{% include "_doc.css" %}</style></head>
<body><div class="doc">
<header class="top">
  {% include "_brand.j2" %}
  <div class="meta">Request for Quotation<br>{{ authority }}<br>Survey: {{ run.name }}<br>Issued {{ generated }}</div>
</header>
<h1>Request for Quotation: road defect repairs</h1>
<p class="sub">{{ sites|length }} sites, {{ boq.lines|length }} repair items, estimated total {{ boq.total|money(sym) }} ({{ boq.currency }}, including {{ boq.contingency_pct }}% contingency)</p>

<h2>1. Summary</h2>{{ sections.executive_summary|md|safe }}
<h2>2. Scope of works</h2>{{ sections.scope_of_works|md|safe }}
<h3>Sites in priority order</h3>
<table><tr><th>Rank</th><th>Site</th><th>Location</th><th>Defects</th><th class="num">Priority</th><th class="num">Site total</th></tr>
{% for s in sites %}{% if boq.sites[s.id] and boq.sites[s.id].lines %}<tr><td>{{ s.rank }}</td><td>{{ s.id }}</td><td>{{ s.street or "Unnamed road" }}<br><span class="small muted">{{ "%.5f"|format(s.lat) }}, {{ "%.5f"|format(s.lon) }}</span></td>
<td>{% for did in s.defect_ids %}{{ did }} ({{ defects[did].severity }}){% if not loop.last %}, {% endif %}{% endfor %}</td><td class="num">{{ s.priority_score }}</td><td class="num">{{ boq.sites[s.id].total|money(sym) }}</td></tr>{% endif %}{% endfor %}
</table>

<h2>3. Bill of quantities</h2>
<table><tr><th>Item</th><th>Unit</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th><th>Defects</th></tr>
{% for b in boq.by_treatment %}<tr><td>{{ b.description }}</td><td>{{ b.unit|replace("m2","m²") }}</td><td class="num">{{ "%.2f"|format(b.qty) }}</td><td class="num">{{ b.rate|money(sym) }}</td><td class="num">{{ b.amount|money(sym) }}</td><td class="small">{{ b.defects|join(", ") }}</td></tr>{% endfor %}
<tr><td colspan="4">Mobilisation and traffic management</td><td class="num">{{ (boq.sites.values()|sum(attribute="mobilisation"))|money(sym) }}</td><td></td></tr>
<tr><td colspan="4">Subtotal</td><td class="num">{{ boq.subtotal|money(sym) }}</td><td></td></tr>
<tr><td colspan="4">Contingency ({{ boq.contingency_pct }}%)</td><td class="num">{{ boq.contingency|money(sym) }}</td><td></td></tr>
<tr class="total"><td colspan="4">Total ({{ boq.currency }})</td><td class="num">{{ boq.total|money(sym) }}</td><td></td></tr></table>
<p class="small muted">Unit rates are placeholders. Quantities come from measured defect sizes and each line names the defects it covers.</p>

<h2>4. Technical specifications</h2>{{ sections.technical_specifications|md|safe }}
<h2>5. Programme</h2>{{ sections.programme|md|safe }}
<h2>6. Safety and traffic management</h2>{{ sections.safety_and_traffic_management|md|safe }}
<h2>7. Measurement method</h2>
<p>Defects were outlined and tracked in the survey video with SAM 3.1, then measured on the road surface using a camera model. Each size is the median over the clearest frames. The range shown accounts for uncertainty in camera height, field of view and horizon.</p>

{% include "_signatures.j2" %}

<h2 class="page-break">Appendix: evidence</h2>{{ sections.evidence_note|md|safe }}
<div class="evidence">
{% for s in sites %}{% for did in s.defect_ids %}{% set d = defects[did] %}{% if d.evidence_frame %}
<figure><img src="../{{ d.evidence_frame }}"><figcaption>{{ d.id }} ({{ s.id }}), {{ d.label }}, severity {{ d.severity }}, {% if d.area_m2 is not none and d.quantity_key != "length_m" %}{{ "%.2f"|format(d.area_m2) }} m²{% elif d.length_m %}{{ "%.1f"|format(d.length_m) }} m{% else %}size {{ d.size_bucket }}{% endif %}</figcaption></figure>
{% endif %}{% endfor %}{% endfor %}
</div>
</div></body></html>
